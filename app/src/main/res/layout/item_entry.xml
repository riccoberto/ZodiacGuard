<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/bg_surface_card"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvEntryInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/app_text"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/btnEdit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Modifica marcatura"
        android:src="@drawable/ic_edit_mark"
        android:background="@drawable/bg_edit_action"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="8dp" />

    <ImageButton
        android:id="@+id/btnDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Elimina marcatura"
        android:src="@drawable/ic_delete_mark"
        android:background="@drawable/bg_delete_action"
        android:padding="11dp"
        android:scaleType="fitCenter" />
</LinearLayout>
