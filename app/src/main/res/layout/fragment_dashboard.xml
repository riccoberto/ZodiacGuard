<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zodiac_navy"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZODIAC GUARD"
            android:textColor="@color/zodiac_gold"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestione ore di lavoro"
            android:textColor="@color/zodiac_gold"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Selettore Categoria -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categoria per questa azione:"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />
            
        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/zodiac_navy"
            android:spinnerMode="dropdown"
            android:entries="@array/work_categories"
            android:layout_marginBottom="24dp" />

        <!-- Pulsanti Entrata e Uscita -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="REGISTRA ENTRATA"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#34C759"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckOut"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="REGISTRA USCITA"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#C41E3A"
            android:layout_marginBottom="24dp" />

        <!-- Registro Giornaliero -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro di Oggi:"
            android:textColor="@color/zodiac_gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDailyLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nessun registro per oggi."
            android:textColor="@color/white"
            android:textSize="14sp"
            android:background="#1AFFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Pulsante Impostazioni -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="IMPOSTAZIONI CONTRATTO"
            android:textSize="14sp"
            app:backgroundTint="@color/zodiac_gold"
            android:textColor="@color/zodiac_navy" />

    </LinearLayout>
</ScrollView>
