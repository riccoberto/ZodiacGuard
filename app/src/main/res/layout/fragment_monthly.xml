<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zodiac_navy"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrevMonth"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="◀"
                android:textSize="18sp"
                app:backgroundTint="@color/zodiac_gold"
                android:textColor="@color/zodiac_navy" />
            
            <TextView
                android:id="@+id/tvMonthYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ottobre 2026"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center" />
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextMonth"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="▶"
                android:textSize="18sp"
                app:backgroundTint="@color/zodiac_gold"
                android:textColor="@color/zodiac_navy" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riepilogo Ore"
            android:textColor="@color/zodiac_gold"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_surface_card"
            android:padding="18dp"
            android:layout_marginBottom="20dp">
            
            <TextView
                android:id="@+id/tvTotalWorked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Totale lavorate: 0h 00m"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:id="@+id/tvContractExpected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contratto attese (0 gg): 0h 00m"
                android:textColor="#FFB74D"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:id="@+id/tvTotalOrdinary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ordinarie: 0h 00m"
                android:textColor="#FFD700"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:id="@+id/tvTotalOvertime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Straordinari: 0h 00m"
                android:textColor="#FF5252"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:id="@+id/tvTotalBank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Banca ore: 0h 00m"
                android:textColor="#64B5F6"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:id="@+id/tvTotalTravel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Viaggio: 0h 00m"
                android:textColor="#B388FF"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:id="@+id/tvBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saldo: 0h 00m"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distribuzione Ore (sfondo arancio = ore attese)"
            android:textColor="@color/zodiac_gold"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <com.zodiacguard.app.ui.monthly.PieChartView
            android:id="@+id/pieChart"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"
            android:contentDescription="Grafico distribuzione ore lavorate e viaggio." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teatrini e Sedi"
            android:textColor="@color/zodiac_gold"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_surface_card"
            android:padding="18dp"
            android:layout_marginBottom="20dp">
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Giorni con Teatrini:"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:id="@+id/tvTeatriniDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nessun teatrino"
                android:textColor="#FFD700"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Teatrini per tipo:"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:id="@+id/tvTeatriniCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nessun teatrino"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Presenze per sede:"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:id="@+id/tvLocationsCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nessuna presenza"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:id="@+id/tvOutOfTown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚗 Giornate fuori sede: 0"
                android:textColor="#B388FF"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />
            
            <TextView
                android:id="@+id/tvMealTickets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="️ Buoni pasto: 0"
                android:textColor="@color/zodiac_gold"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agenda Giornaliera"
            android:textColor="@color/zodiac_gold"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_marginBottom="12dp" />
        
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewAgenda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleAgenda"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:text="@string/show_all_days"
            android:textSize="12sp"
            android:textColor="@color/zodiac_gold"
            app:backgroundTint="@color/zodiac_surface_raised"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareReport"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ESPORTA RIEPILOGO PDF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_pdf"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:backgroundTint="@color/zodiac_gold"
            android:textColor="@color/zodiac_navy"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
