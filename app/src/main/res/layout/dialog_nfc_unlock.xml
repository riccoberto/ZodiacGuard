<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_nfc_unlock"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCESSO RAPIDO · NFC"
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marcatura rapida"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvBadgeInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Badge rilevato"
            android:textColor="#D7DCEC"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:padding="10dp"
            android:background="#222A40" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sblocca la marcatura"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trascina il cursore fino in fondo per continuare."
            android:textColor="#AAB3C5"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:value="0"
            app:thumbColor="#FFD700"
            app:trackColorActive="#FFD700"
            app:trackColorInactive="#3F4A60"
            app:tickVisible="false"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/layoutDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:alpha="0.3"
            android:clickable="false"
            android:focusable="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attività"
                android:textColor="#AAB3C5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />
            
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxStrokeColor="#FFD700"
                app:hintTextColor="#FFD700"
                app:boxBackgroundColor="#2A2A3E">
                
                <AutoCompleteTextView
                    android:id="@+id/actvActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Seleziona attività"
                    android:text="Servizio"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:paddingVertical="12dp"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Luogo / Sede"
                android:textColor="#AAB3C5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />
            
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxStrokeColor="#FFD700"
                app:hintTextColor="#FFD700"
                app:boxBackgroundColor="#2A2A3E">
                
                <AutoCompleteTextView
                    android:id="@+id/actvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Seleziona luogo"
                    android:text="Modena"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:paddingVertical="12dp"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp"
                android:paddingVertical="4dp">
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Modalità Produzione"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
                
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchProduction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    app:thumbTint="#FFD700"
                    app:trackTint="#66BB6A" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:alpha="0.3"
            android:clickable="false"
            android:focusable="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckIn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="ENTRATA"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#66BB6A"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckOut"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="USCITA"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#FF5252"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="ANNULLA"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#222A40"
            android:textColor="#D7DCEC"
            android:layout_marginTop="12dp"
            android:maxLines="1"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>
