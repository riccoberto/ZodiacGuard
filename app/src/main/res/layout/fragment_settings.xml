<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Impostazioni personali"
            android:textColor="@color/zodiac_gold"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Il nome scelto apparirà accanto al mese nel PDF riepilogativo."
            android:textColor="@color/zodiac_text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="Nome da mostrare nel PDF"
            app:boxStrokeColor="@color/zodiac_gold"
            app:hintTextColor="@color/zodiac_gold">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="50"
                android:singleLine="true"
                android:textColor="@color/app_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tema dell'app"
            android:textColor="@color/app_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Automatico segue il tema impostato sul telefono."
            android:textColor="@color/app_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerTheme"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:entries="@array/theme_modes"
            android:background="@color/zodiac_surface"
            android:popupBackground="@color/zodiac_surface"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Il Mio Contratto"
            android:textColor="@color/zodiac_gold"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <!-- Ore settimanali contrattuali -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ore settimanali contrattuali"
            android:textColor="@color/app_text"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxStrokeColor="@color/zodiac_gold"
            app:hintTextColor="@color/zodiac_gold">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWeeklyHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ore, es. 38"
                android:inputType="number"
                android:textColor="@color/app_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxStrokeColor="@color/zodiac_gold"
            app:hintTextColor="@color/zodiac_gold">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWeeklyMinutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Minuti, es. 30"
                android:inputType="number"
                android:textColor="@color/app_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Giorni Lavorativi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giorni lavorativi a settimana"
            android:textColor="@color/app_text"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:boxStrokeColor="@color/zodiac_gold"
            app:hintTextColor="@color/zodiac_gold">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWorkDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Es. 6"
                android:inputType="number"
                android:textColor="@color/app_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveContract"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SALVA IMPOSTAZIONI"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/zodiac_gold"
            android:textColor="@color/zodiac_navy" />

        <!-- Divisore -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/zodiac_outline"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp" />

        <!-- Sezione NFC -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrazione Badge NFC"
            android:textColor="@color/zodiac_gold"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Premi il tasto sotto. 2. Avvicina il badge. 3. Guarda la console qui sotto."
            android:textColor="@color/app_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegisterNfc"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="REGISTRA IL MIO BADGE"
            android:textSize="16sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_nfc"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:backgroundTint="#64B5F6"
            android:textColor="@color/app_text"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvNfcStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stato: Nessun badge registrato"
            android:textColor="@color/app_text"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Divisore -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/zodiac_outline"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp" />

        <!-- Sezione Backup -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Backup e Ripristino"
            android:textColor="@color/zodiac_gold"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Il backup automatico viene aggiornato all'avvio e all'uscita. In Download/ZGuard trovi l'ultimo JSON e fino a 20 copie storiche. Importando un file, le marcature vengono unite senza cancellare quelle già presenti."
            android:textColor="@color/app_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBackup"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ESPORTA BACKUP JSON"
            android:textSize="16sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_restore"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:backgroundTint="@color/zodiac_gold"
            android:textColor="@color/zodiac_navy"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestoreBackup"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="RIPRISTINA DA BACKUP"
            android:textSize="16sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_restore"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:backgroundTint="#66BB6A"
            android:textColor="@color/app_text"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecoverAutoBackup"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="RECUPERA BACKUP AUTOMATICO LOCALE"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#64B5F6"
            android:textColor="@color/zodiac_navy"
            android:layout_marginBottom="16dp" />

        <!-- Console di Debug -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖥️ Console di Debug:"
            android:textColor="@color/zodiac_gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
            
        <TextView
            android:id="@+id/tvDebugLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="150dp"
            android:background="@drawable/bg_surface_card"
            android:textColor="#9AE6B4"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="In attesa...\n" />

    </LinearLayout>
</ScrollView>
