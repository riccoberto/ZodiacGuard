<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_surface_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvCounterTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/zodiac_gold"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCounterValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/app_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCounterInitial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="#AAB7CA"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvCounterDayLength"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="#AAB7CA"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etAdjustDays"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:hint="@string/manual_counter_days"
            android:inputType="number"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:textColor="@color/app_text"
            android:textColorHint="#AAB7CA" />

        <EditText
            android:id="@+id/etAdjustHours"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:hint="@string/manual_counter_hours"
            android:inputType="number"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:textColor="@color/app_text"
            android:textColorHint="#AAB7CA" />

        <EditText
            android:id="@+id/etAdjustMinutes"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:hint="@string/manual_counter_minutes"
            android:inputType="number"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:textColor="@color/app_text"
            android:textColorHint="#AAB7CA" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddUnits"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/manual_counter_add_units"
            android:textSize="12sp"
            android:textColor="@color/zodiac_navy"
            app:backgroundTint="@color/zodiac_gold"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemoveUnits"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/manual_counter_remove_units"
            android:textSize="12sp"
            android:textColor="@color/app_text"
            app:backgroundTint="@color/zodiac_surface_raised"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteCounter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:text="@string/manual_counter_delete"
            android:textSize="10sp"
            android:textColor="@color/app_text"
            app:backgroundTint="#8A3434"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
