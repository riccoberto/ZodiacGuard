<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zodiac_navy"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ZGUARD"
        android:textColor="@color/zodiac_gold"
        android:textSize="44sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.14"
        android:layout_marginBottom="32dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDashboard"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="REGISTRA ORE"
        android:textSize="15sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_home_clock"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:backgroundTint="#66BB6A"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWeekly"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="RIEPILOGO SETTIMANALE"
        android:textSize="15sp"
        app:icon="@drawable/ic_home_weekly"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:backgroundTint="@color/zodiac_gold"
        android:textColor="@color/zodiac_navy"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMonthly"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="RIEPILOGO MENSILE"
        android:textSize="15sp"
        app:icon="@drawable/ic_home_monthly"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:backgroundTint="@color/zodiac_gold"
        android:textColor="@color/zodiac_navy"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="IMPOSTAZIONI"
        android:textSize="15sp"
        app:icon="@drawable/ic_home_settings"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:backgroundTint="@color/zodiac_gold"
        android:textColor="@color/zodiac_navy" />

</LinearLayout>
