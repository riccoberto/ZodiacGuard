<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema principale dell'applicazione -->
    <style name="Theme.ZodiacGuard" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/zodiac_gold</item>
        <item name="colorPrimaryVariant">@color/zodiac_gold</item>
        <item name="colorOnPrimary">@color/zodiac_navy</item>
        <item name="colorSecondary">@color/zodiac_gold</item>
        <item name="colorSecondaryVariant">@color/zodiac_gold</item>
        <item name="colorOnSecondary">@color/zodiac_navy</item>
        <item name="colorSurface">@color/zodiac_surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorAccent">@color/zodiac_gold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialButtonStyle">@style/Widget.ZodiacGuard.Button</item>
        <item name="textInputStyle">@style/Widget.ZodiacGuard.TextInputLayout</item>
        <item name="android:colorControlHighlight">#33F2C94C</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/zodiac_navy</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/zodiac_navy</item>
    </style>

    <style name="Widget.ZodiacGuard.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.ZodiacGuard.TextInputLayout"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/zodiac_gold</item>
        <item name="hintTextColor">@color/zodiac_gold</item>
        <item name="boxBackgroundColor">@color/zodiac_surface</item>
    </style>

    <!-- Tema specifico per lo Splash Screen (schermo intero e sfondo blu scuro) -->
    <style name="Theme.Splash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/zodiac_navy</item>
        <item name="android:statusBarColor">@color/zodiac_navy</item>
        <item name="android:navigationBarColor">@color/zodiac_navy</item>
    </style>

</resources>
